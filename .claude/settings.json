{
  "permissions": {
    "allow": [
      "Bash(./libtest:missing *)",
      "Bash(./libtest:triage-status *)",
      "Bash(./report:latest *)",
      "Bash(vendor/bin/phpstan analyse *)",
      "Bash(./libtest:run *)",
      "Bash(sed -n *)",
      "Bash(docker exec ultiorganizer-tests-php-test-1 *)",
      "Bash(./test:unit *)",
      "Bash(./test:integration *)",
      "Bash(./test:filter *)",
      "Bash(./libtest:catalog-refresh *)",
      "Bash(./test:quick *)",
      "Bash(./test:matrix *)",
      "Bash(./test:case *)",
      "Bash(./libtest:coverage *)",
      "Bash(./libtest:scaffold *)",
      "Bash(./test:js *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.php) out=$(php -l \"$f\" 2>&1) || { printf '%s\\n' \"$out\" >&2; exit 2; };; esac; }",
            "timeout": 30,
            "statusMessage": "Checking PHP syntax"
          }
        ]
      }
    ]
  }
}
